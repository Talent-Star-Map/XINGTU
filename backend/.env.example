# Copy to .env and fill locally. Never commit credentials.
DATABASE_URL=
JWT_SECRET=
SMTP_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
MYSQL_PASSWORD=
FRONTEND_BASE_URL=http://127.0.0.1:3000

# PC interview: browser RNNoise/CV; server CPU speaker verification.
# Run backend/scripts/setup_interview_models.py before enabling.
INTERVIEW_ASR_MODE=browser
INTERVIEW_AUDIO_THREADS=1
INTERVIEW_SPEAKER_THRESHOLD=0.55
# Optional HTTPS OpenAI-compatible audio-transcription API (not chat completions).
INTERVIEW_ASR_URL=
INTERVIEW_ASR_API_KEY=
INTERVIEW_ASR_MODEL=

# Optional isolated official DeerFlow runtime; do not install into API venv.
# Run scripts/install_career_sdk.py and manually apply sql/career_assistant.sql.
# Windows: D:/XINGTU/backend/.career-venv/Scripts/python.exe
# Linux container: /opt/career-sdk/bin/python
CAREER_SDK_PYTHON=
