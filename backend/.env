# 服务端口
BACKEND_PORT=8081

# 数据库连接
# - Docker 部署（云服务器容器内）：用 mysql:3306（容器名 + 容器端口）
# - 本地后端直连云服务器库（当前使用）：用 180.76.227.159:3308（需云安全组放行 3308）
# - 切回本地库：用 localhost:3308
DATABASE_URL=mysql+pymysql://root:Xingtu123@180.76.227.159:3308/xingtu

# JWT 密钥（32+ 字节，生产环境用强随机字符串）
JWT_SECRET=xingtu-prod-secret-key-2026-very-long-and-random

# DeepSeek API（图图 AI 问答 + 简历解析）
DEEPSEEK_API_KEY=你的deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Neo4j (岗位知识图谱) ─────────────────────────────────────────
NEO4J_URI=bolt://180.76.227.159:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Xingtu123
NEO4J_DATABASE=neo4j

# OpenAI (text-embedding-3-small 1536 维 + 备用 LLM)
OPENAI_API_KEY=你的openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# SMTP 邮箱（验证码发送）
SMTP_PASSWORD=hjncdropikuccjef

# ── 简历导出（Playwright 驱动前端 React 渲染 PDF/HTML） ─────────────────
# 前端基础 URL — Playwright 加载 /print/{token} 时用这个拼接完整 URL
# - 本地 dev (Vite): http://127.0.0.1:5173
# - Docker 容器内: http://frontend (docker-compose 已默认配)
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Chromium / Chrome / Edge 可执行文件路径(可选,不填则自动探测)
# - Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# - Linux:   /usr/bin/chromium 或 /usr/bin/google-chrome
# - macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROMIUM_PATH=
