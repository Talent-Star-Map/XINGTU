{
  "manifest_version": 3,
  "name": "星图 · 小星陪伴",
  "version": "1.0.0",
  "description": "打开星图时唤起小星，浏览器后台继续陪伴。",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://47.120.76.16/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:15185/*",
    "http://localhost:15185/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://47.120.76.16/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:15185/*",
        "http://localhost:15185/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "打开星图与小星"
  }
}
