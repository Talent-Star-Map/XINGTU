# 参考音频在 GPT-SoVITS 服务器上的绝对路径，使用有授权的声音
INTERVIEW_TTS_REF_AUDIO=
INTERVIEW_TTS_PROMPT_TEXT=
INTERVIEW_TTS_PROMPT_LANG=zh
# 仅当推理服务前置了鉴权网关时填写
INTERVIEW_TTS_TOKEN=
