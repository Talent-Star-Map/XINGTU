# Copy to .env and supply credentials locally. Never commit .env.
# Source collection MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=talent_map

# Destination application MySQL
SERVER_DB_HOST=127.0.0.1
SERVER_DB_PORT=3308
SERVER_DB_USER=root
SERVER_DB_PASSWORD=
SERVER_DB_NAME=xingtu

# GitHub and MongoDB
GITHUB_TOKEN=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=

# Neo4j and optional analysis
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
