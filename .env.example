# Compose interpolation only; API configuration is backend/.env
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
JWT_SECRET=

# GPT-SoVITS api_v2 服务（服务端内部地址；为空时前端提示配置未就绪）
